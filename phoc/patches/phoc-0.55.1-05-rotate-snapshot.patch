+static gboolean
+snapshot_frame_cb (PhocAnimatable *animatable, guint64 last_frame, gpointer user_data)
+{
+  PhocOutputShield *self = PHOC_OUTPUT_SHIELD (animatable);
+  const char *ms_str = g_getenv ("PHOC_ROTATE_RECEDE_MS");
+  double ms = ms_str ? g_ascii_strtod (ms_str, NULL) : 250.0;
+
+  if (self->snapshot == NULL || self->output == NULL) {
+    self->snapshot_frame_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+  self->snapshot_progress = ms > 0 ?
+    CLAMP ((g_get_monotonic_time () - self->snapshot_start_us) / 1000.0 / ms, 0.0, 1.0) : 1.0;
+  phoc_output_damage_whole (self->output);
+  if (self->snapshot_progress >= 1.0) {
+    /* done: no more redraws while the old frame just stays */
+    self->snapshot_frame_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+
+/*
+ * Rotation snapshot: the old frame is in buffer coordinates of the old transform. Turn it
+ * back upright (inverse of the old transform), then apply the new output transform, and fit
+ * it into the output keeping its proportions (black bars from the shield around it).
+ */
+static void
+render_snapshot (PhocOutputShield *self, PhocRenderContext *ctx)
+{
+  struct wlr_output *wlr_output = ctx->output->wlr_output;
+  float alpha = phoc_color_rect_get_alpha (self->color_rect);
+  struct wlr_box box;
+  pixman_region32_t damage;
+  double p, s;
+  int fw, fh;
+
+  /*
+   * Show the old frame exactly as it was on the panel (old orientation): it is in buffer
+   * coordinates already, so no transform, only the "recede" around the centre:
+   * shrink to 85 % and dim to 60 % (ease-out).
+   */
+  p = 1.0 - pow (1.0 - self->snapshot_progress, 3);
+  s = 1.0 - 0.15 * p;
+  alpha *= 1.0 - 0.4 * p;
+  fw = (int) (wlr_output->width * s + 0.5);
+  fh = (int) (wlr_output->height * s + 0.5);
+  box = (struct wlr_box) {
+    .x = (wlr_output->width - fw) / 2,
+    .y = (wlr_output->height - fh) / 2,
+    .width = fw,
+    .height = fh,
+  };
+  if (!phoc_utils_is_damaged (&box, ctx->damage, NULL, &damage)) {
+    pixman_region32_fini (&damage);
+    return;
+  }
+  wlr_render_pass_add_texture (ctx->render_pass, &(struct wlr_render_texture_options) {
+      .alpha     = &alpha,
+      .texture   = self->snapshot,
+      .dst_box   = box,
+      .clip      = &damage,
+      .transform = WL_OUTPUT_TRANSFORM_NORMAL,
+      .filter_mode = WLR_SCALE_FILTER_BILINEAR,
+    });
+  pixman_region32_fini (&damage);
+}
