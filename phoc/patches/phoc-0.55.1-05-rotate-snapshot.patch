+/**
+ * phoc_output_shield_set_snapshot:
+ * @self: The shield
+ * @texture: (transfer full): the last frame before a rotation
+ * @transform: the output transform that frame was drawn with
+ *
+ * Show @texture (turned upright) on the shield until it is lowered.
+ */
+void
+phoc_output_shield_set_snapshot (PhocOutputShield        *self,
+                                 struct wlr_texture      *texture,
+                                 struct wlr_buffer       *buffer,
+                                 enum wl_output_transform transform)
+{
+  g_return_if_fail (PHOC_IS_OUTPUT_SHIELD (self));
+
+  g_clear_pointer (&self->snapshot, wlr_texture_destroy);
+  g_clear_pointer (&self->snapshot_buffer, wlr_buffer_unlock);
+  self->snapshot = texture;
+  self->snapshot_buffer = buffer ? wlr_buffer_lock (buffer) : NULL;
+  self->snapshot_transform = transform;
+  self->snapshot_progress = 0.0;
+  self->snapshot_start_us = g_get_monotonic_time ();
+  if (self->snapshot_frame_id == 0 && self->output)
+    self->snapshot_frame_id = phoc_animatable_add_frame_callback (PHOC_ANIMATABLE (self),
+                                                                  snapshot_frame_cb, NULL, NULL);
+}
